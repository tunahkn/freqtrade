//@version=6
// ============================================================================
// APEX SNIPER v9 STRATEGY
// ----------------------------------------------------------------------------
// Upgrade of APEX SNIPER v8. Same SMC/ICT confluence engine, but with the
// flaws that kept v8 below a 10/10 fixed:
//
//   1) RISK-BASED POSITION SIZING (no more 100%-of-equity all-in per trade).
//      Each trade risks a fixed % of equity; qty = riskCapital / stopDist.
//   2) PLACEBO INPUTS GATED. funding / long-short / gamma only affect the
//      score when `use_derivs` is ON and you actually feed real values.
//      Otherwise the score is built from factors that are live in a backtest.
//   3) FEE-AWARE BREAKEVEN. BE stop is offset by the round-trip fee buffer,
//      so "breakeven" is actually flat, not a quiet -0.1% bleed.
//   4) RISK GUARDS. Daily loss limit + consecutive-loss lockout.
//   5) POC FIX. Recomputed more often, reclaim checked every bar.
//   6) OVERFIT REDUCTION. Regime weight matrix is optional; a single balanced
//      weight set is the default. Category-capped, normalized scoring.
//   7) WALK-FORWARD HELPER. Optional in-sample / out-of-sample split marker.
//
// Entry: Grade A/B sniper only. Exit: tiered TP1/TP2/TP3 + fee-aware breakeven.
// ============================================================================
strategy("APEX SNIPER v9 STRATEGY", shorttitle = "APEX v9 STR", overlay = true,
     max_boxes_count = 200, max_lines_count = 200, max_labels_count = 200,
     initial_capital = 10000, default_qty_type = strategy.fixed, default_qty_value = 1,
     commission_type = strategy.commission.percent, commission_value = 0.05, slippage = 2,
     calc_on_every_tick = false, process_orders_on_close = true)

enum Direction
    long
    short
    neutral

enum Regime
    momentum
    meanrev
    unknown

type FVG
    float top
    float bot
    int   bar
    bool  bull
    bool  mit
    box   bx
    line  ce

// ===== INPUTS =====
htf_tf     = input.timeframe("240", "HTF Timeframe", group = "Engine")
ma_len     = input.int(50,  "HTF MA Length",  minval = 1, group = "Engine")
ma_type    = input.string("EMA", "HTF MA Type", options = ["EMA","SMA"], group = "Engine")
swing_len  = input.int(5,   "Swing Length",   minval = 1, group = "Engine")
fvg_mult   = input.float(0.7, "FVG min size (xATR)", minval = 0.0, group = "Engine")
fvg_max    = input.int(8,   "Max FVG zones",  minval = 1, group = "Engine")
ob_mult    = input.float(0.8, "OB min size (xATR)", minval = 0.0, group = "Engine")
liq_lb     = input.int(20,  "Liquidity Lookback", minval = 2, group = "Engine")
wick_rej   = input.bool(true, "Require wick rejection on sweep", group = "Engine")
tz         = input.string("America/New_York", "Timezone", group = "Engine")
sess_lon   = input.session("0200-0500", "London KZ", group = "Engine")
sess_nyam  = input.session("0830-1100", "New York AM KZ", group = "Engine")
sess_sb    = input.session("1000-1100", "Silver Bullet", group = "Engine")
vp_lb      = input.int(200, "VP Lookback",  minval = 20, group = "Engine")
vp_bins    = input.int(24,  "VP Bins",      minval = 4, maxval = 60, group = "Engine")
va_pct     = input.float(0.70, "Value Area %", minval = 0.3, maxval = 0.95, group = "Engine")
vp_every   = input.int(2,   "VP recompute every N bars", minval = 1, maxval = 10, group = "Engine")
cvd_reset  = input.bool(true, "Reset CVD daily", group = "Engine")
adx_len    = input.int(14,  "ADX Length",   minval = 1, group = "Engine")
adx_th     = input.float(20, "ADX trend threshold", group = "Engine")
rvol_len   = input.int(20,  "RVOL Length",  minval = 1, group = "Engine")
rvol_min   = input.float(1.3, "Min RVOL", minval = 0.0, group = "Engine")

// --- Derivatives factors: OFF by default (these are static unless you feed real data) ---
use_derivs = input.bool(false, "Use funding / L-S in score (feed REAL values)", group = "Derivatives (optional)")
funding    = input.float(0.0, "Funding rate % (8h)", group = "Derivatives (optional)")
ls_ratio   = input.float(1.0, "Long/Short ratio",  minval = 0.0, group = "Derivatives (optional)")
gamma_flip = input.float(0.0, "Gamma flip level (0=off)", group = "Derivatives (optional)")

// --- Scoring ---
use_regime_w = input.bool(false, "Use regime-adaptive weights (overfit risk)", group = "Scoring")
sniper_th  = input.int(14,  "Sniper threshold", minval = 1, maxval = 20, group = "Scoring")
watch_th   = input.int(10,  "Watch threshold",  minval = 1, maxval = 20, group = "Scoring")
minCats    = input.int(3,   "Min categories", minval = 1, maxval = 4, group = "Scoring")
setup_win  = input.int(10,  "Setup memory window (bars)", minval = 1, maxval = 50, group = "Scoring")
gradeAB    = input.bool(true, "Only Grade A/B entries", group = "Scoring")
useShortRegime = input.bool(true,  "Short only below regime EMA (OOS fix)", group = "Scoring")
shortEmaLen    = input.int(200, "Short regime EMA length", minval = 10, maxval = 500, group = "Scoring")

// ===== RISK / EXIT =====
riskPct    = input.float(1.0, "Risk per trade (% equity)", minval = 0.05, maxval = 10, group = "Risk & Exit")
atr_stop_m = input.float(1.5, "ATR Stop multiplier", minval = 0.1, group = "Risk & Exit")
rr_target  = input.float(2.0, "R multiple per TP step", minval = 0.5, group = "Risk & Exit")
use_be     = input.bool(true, "Move stop to breakeven after TP1", group = "Risk & Exit")
feeBufPct  = input.float(0.12, "Round-trip fee+slip buffer % (for BE)", minval = 0.0, group = "Risk & Exit")
maxBarsIn  = input.int(0, "Time stop (bars, 0=off)", minval = 0, group = "Risk & Exit")
// --- exit model (v9.1: fixes the "cut winners short" negative edge) ---
useScaleOut = input.bool(false, "Scale out 1/3 at TP1/TP2 (off = let winner run)", group = "Exit Model")
useTrail    = input.bool(true,  "ATR trailing stop (let winners run)", group = "Exit Model")
trailAtrM   = input.float(2.5, "Trailing ATR multiplier", minval = 0.5, group = "Exit Model")
trailStart  = input.float(1.0, "Start trailing after R multiple", minval = 0.0, group = "Exit Model")

// --- Risk guards ---
maxDayLossPct = input.float(3.0, "Max daily loss % (0=off)", minval = 0.0, group = "Risk Guards")
maxConsecLoss = input.int(3,   "Max consecutive losses (0=off)", minval = 0, group = "Risk Guards")

// ===== DATE FILTER / WALK-FORWARD =====
useDates = input.bool(false, "Limit backtest date range", group = "Date Range")
fromDate = input.time(timestamp("01 Jan 2024 00:00"), "From", group = "Date Range")
toDate   = input.time(timestamp("01 Jan 2027 00:00"), "To",   group = "Date Range")
oosDate  = input.time(timestamp("01 Jan 2026 00:00"), "OOS split (visual marker)", group = "Date Range")
showOOS  = input.bool(true, "Shade out-of-sample period", group = "Date Range")
inRange  = (not useDates) or (time >= fromDate and time <= toDate)

// ===== HELPERS =====
maFn(src, len, t) => t == "EMA" ? ta.ema(src, len) : ta.sma(src, len)
inSess(s) => na(time(timeframe.period, s, tz)) ? false : true

// ===== DISPLACEMENT =====
float volBase = ta.sma(volume, rvol_len)[1]
bool  hasVol  = not na(volume) and not na(volBase) and volBase > 0
float rvol    = hasVol ? volume / volBase : 1.0
bool  disp    = (not hasVol) or (rvol >= rvol_min)

// ===== HTF BIAS =====
bool  htfValid    = timeframe.in_seconds(htf_tf) >= timeframe.in_seconds(timeframe.period)
float htfCloseRaw = request.security(syminfo.tickerid, htf_tf, close, lookahead = barmerge.lookahead_off)
float htfMaRaw    = request.security(syminfo.tickerid, htf_tf, maFn(close, ma_len, ma_type), lookahead = barmerge.lookahead_off)
float htfClose    = htfValid ? htfCloseRaw : close
float htfMa       = htfValid ? htfMaRaw    : maFn(close, ma_len, ma_type)
bool  biasLong    = not na(htfClose) and not na(htfMa) and htfClose > htfMa
bool  biasShort   = not na(htfClose) and not na(htfMa) and htfClose < htfMa
Direction biasDir = biasLong ? Direction.long : biasShort ? Direction.short : Direction.neutral

float atrVal = ta.atr(14)
float shortRegEma = ta.ema(close, shortEmaLen)

// ===== SWINGS + STRUCTURE =====
float ph = ta.pivothigh(high, swing_len, swing_len)
float pl = ta.pivotlow(low,  swing_len, swing_len)
var float lastSH = na
var float lastSL = na
if not na(ph)
    lastSH := ph
if not na(pl)
    lastSL := pl
bool brokeHigh = not na(lastSH) and close > lastSH and close[1] <= lastSH
bool brokeLow  = not na(lastSL) and close < lastSL and close[1] >= lastSL
bool bosUp     = brokeHigh and biasDir == Direction.long
bool bosDown   = brokeLow  and biasDir == Direction.short
bool chochUp   = brokeHigh and biasDir == Direction.short
bool chochDown = brokeLow  and biasDir == Direction.long

// ===== FVG =====
var array<FVG> fvgs = array.new<FVG>()
bool newBull = bar_index > 1 and barstate.isconfirmed and low  > high[2] and (low - high[2]) >= atrVal * fvg_mult and disp
bool newBear = bar_index > 1 and barstate.isconfirmed and high < low[2]  and (low[2] - high) >= atrVal * fvg_mult and disp
if newBull
    array.push(fvgs, FVG.new(low, high[2], bar_index, true, false, na, na))
if newBear
    array.push(fvgs, FVG.new(low[2], high, bar_index, false, false, na, na))
// CE-tap detection BEFORE mitigation removal so a same-bar tap is not lost
bool bullFvgTap = false
bool bearFvgTap = false
if array.size(fvgs) > 0
    for i = 0 to array.size(fvgs) - 1
        FVG f = array.get(fvgs, i)
        float ceLvl = (f.top + f.bot) / 2.0
        bool  tapCE = low <= ceLvl and high >= ceLvl and (bar_index - f.bar) < 100
        if tapCE and f.bull
            bullFvgTap := true
        if tapCE and not f.bull
            bearFvgTap := true
// now remove fully mitigated zones
if array.size(fvgs) > 0
    for i = array.size(fvgs) - 1 to 0
        FVG f = array.get(fvgs, i)
        bool mit = (f.bull and low <= f.bot) or ((not f.bull) and high >= f.top)
        if mit
            array.remove(fvgs, i)
while array.size(fvgs) > fvg_max
    array.shift(fvgs)

// ===== LIQUIDITY SWEEPS =====
float bslLvl   = ta.highest(high, liq_lb)[1]
float sslLvl   = ta.lowest(low,  liq_lb)[1]
bool  bslRaw   = not na(bslLvl) and high > bslLvl and (wick_rej ? close < bslLvl : true)
bool  sslRaw   = not na(sslLvl) and low  < sslLvl and (wick_rej ? close > sslLvl : true)
bool  bslSwept = bslRaw and not bslRaw[1]
bool  sslSwept = sslRaw and not sslRaw[1]

// ===== PREMIUM / DISCOUNT + OTE =====
float rH = ta.highest(high, 50)
float rL = ta.lowest(low, 50)
float rng50 = na(rH) or na(rL) ? na : rH - rL
float rM = na(rH) or na(rL) ? na : (rH + rL) / 2.0
bool inDiscount = not na(rM) and close < rM
bool inPremium  = not na(rM) and close > rM
bool oteLong    = not na(rng50) and rng50 > 0 and close >= rH - rng50 * 0.79 and close <= rH - rng50 * 0.62
bool oteShort   = not na(rng50) and rng50 > 0 and close >= rL + rng50 * 0.62 and close <= rL + rng50 * 0.79

// ===== CVD DIVERGENCE (body-ratio proxy; replace with real delta feed if available) =====
float bodyR = math.abs(close - open) / math.max(high - low, syminfo.mintick)
float buyV  = nz(volume) * (close >= open ? bodyR : 1 - bodyR)
float sellV = nz(volume) * (close <  open ? bodyR : 1 - bodyR)
float delta = buyV - sellV
var float cvd = 0.0
cvd := (cvd_reset and ta.change(time("D")) != 0) ? delta : cvd[1] + delta
float pLow = ta.pivotlow(low, 5, 5)
float pHigh = ta.pivothigh(high, 5, 5)
var float lastPL = na
var float lastCvdAtPL = na
var float lastPH = na
var float lastCvdAtPH = na
var int   bullDivBars = 0
var int   bearDivBars = 0
if not na(pLow)
    float cAtPiv = cvd[5]
    if not na(lastPL) and not na(lastCvdAtPL) and pLow < lastPL and cAtPiv > lastCvdAtPL
        bullDivBars := 6
    lastPL := pLow
    lastCvdAtPL := cAtPiv
if not na(pHigh)
    float cAtPiv = cvd[5]
    if not na(lastPH) and not na(lastCvdAtPH) and pHigh > lastPH and cAtPiv < lastCvdAtPH
        bearDivBars := 6
    lastPH := pHigh
    lastCvdAtPH := cAtPiv
bullDivBars := math.max(0, bullDivBars - 1)
bearDivBars := math.max(0, bearDivBars - 1)
bool bullDiv = bullDivBars > 0
bool bearDiv = bearDivBars > 0

// ===== VWAP =====
bool newDay = ta.change(time("D")) != 0
float avwap = ta.vwap(hlc3, newDay)
bool aboveVwap = not na(avwap) and close > avwap
bool belowVwap = not na(avwap) and close < avwap

// ===== VOLUME PROFILE (POC) =====
var float poc = na
bool vpCalc = bar_index >= vp_lb and barstate.isconfirmed and (bar_index % vp_every == 0)
if vpCalc
    float hi = ta.highest(high, vp_lb)
    float lo = ta.lowest(low, vp_lb)
    float rng = hi - lo
    if rng > 0
        float binW = rng / vp_bins
        array<float> bins = array.new<float>(vp_bins, 0.0)
        for k = 0 to vp_lb - 1
            float price = (high[k] + low[k] + close[k]) / 3.0
            int idx = int(math.floor((price - lo) / math.max(binW, syminfo.mintick)))
            idx := math.max(0, math.min(vp_bins - 1, idx))
            array.set(bins, idx, array.get(bins, idx) + nz(volume[k]))
        int pocIdx = 0
        float maxV = -1.0
        for b = 0 to vp_bins - 1
            float v = array.get(bins, b)
            if v > maxV
                maxV := v
                pocIdx := b
        poc := lo + (pocIdx + 0.5) * binW
bool pocReclaimUp = not na(poc) and close > poc and close[1] <= poc
bool pocReclaimDn = not na(poc) and close < poc and close[1] >= poc

// ===== REGIME =====
[diP, diM, adx] = ta.dmi(adx_len, adx_len)
bool gexKnown = use_derivs and gamma_flip != 0.0
Regime regime = gexKnown ? (close > gamma_flip ? Regime.meanrev : Regime.momentum) : (not na(adx) and adx > adx_th ? Regime.momentum : Regime.meanrev)

// ===== KILL ZONES =====
bool inKZ = inSess(sess_lon) or inSess(sess_nyam) or inSess(sess_sb)

// ===== SEQUENCE MEMORY =====
f_active(bool ev, int win) =>
    var int cnt = 0
    cnt := ev ? win : math.max(0, cnt - 1)
    cnt > 0
bool sslActive = f_active(sslSwept, setup_win)
bool bslActive = f_active(bslSwept, setup_win)
bool bosUpAct  = f_active(bosUp or chochUp, setup_win)
bool bosDnAct  = f_active(bosDown or chochDown, setup_win)
bool pocUpAct  = f_active(pocReclaimUp, setup_win)
bool pocDnAct  = f_active(pocReclaimDn, setup_win)

// ===== SCORING =====
// Single balanced weight set by default; regime-adaptive only if explicitly enabled.
bool isMom = regime == Regime.momentum
int wTrend = use_regime_w ? (isMom ? 12 : 8)  : 10
int wStruct= use_regime_w ? (isMom ? 13 : 9)  : 11
int wLiq   = use_regime_w ? (isMom ? 9  : 12) : 10
int wLoc   = use_regime_w ? (isMom ? 8  : 13) : 10

bool lVwapAgree = aboveVwap and biasDir == Direction.long
bool sVwapAgree = belowVwap and biasDir == Direction.short

// derivs terms only count when enabled AND real data is fed
int lDeriv = (use_derivs and (funding < -0.03 or ls_ratio < 0.7)) ? 1 : 0
int sDeriv = (use_derivs and (funding >  0.05 or ls_ratio > 1.5)) ? 1 : 0

int lc_trend = math.min(5, (biasDir == Direction.long  ? 3 : 0) + (lVwapAgree ? 2 : 0))
int sc_trend = math.min(5, (biasDir == Direction.short ? 3 : 0) + (sVwapAgree ? 2 : 0))
int lc_liq = math.min(5, (sslActive ? 3 : 0) + (bullDiv ? 1 : 0) + lDeriv)
int sc_liq = math.min(5, (bslActive ? 3 : 0) + (bearDiv ? 1 : 0) + sDeriv)
int lc_str = math.min(5, (bosUpAct ? 3 : 0) + (bullFvgTap ? 2 : 0))
int sc_str = math.min(5, (bosDnAct ? 3 : 0) + (bearFvgTap ? 2 : 0))
int lc_loc = math.min(4, ((inDiscount or oteLong) ? 2 : 0) + (pocUpAct ? 1 : 0) + (inKZ ? 1 : 0))
int sc_loc = math.min(4, ((inPremium or oteShort) ? 2 : 0) + (pocDnAct ? 1 : 0) + (inKZ ? 1 : 0))

float lRaw = lc_trend * wTrend + lc_liq * wLiq + lc_str * wStruct + lc_loc * wLoc
float sRaw = sc_trend * wTrend + sc_liq * wLiq + sc_str * wStruct + sc_loc * wLoc
float maxRaw = 5 * wTrend + 5 * wLiq + 5 * wStruct + 4 * wLoc
int longScore  = math.round(lRaw / maxRaw * 20)
int shortScore = math.round(sRaw / maxRaw * 20)
int lCats = (lc_trend > 0 ? 1 : 0) + (lc_liq > 0 ? 1 : 0) + (lc_str > 0 ? 1 : 0) + (lc_loc > 0 ? 1 : 0)
int sCats = (sc_trend > 0 ? 1 : 0) + (sc_liq > 0 ? 1 : 0) + (sc_str > 0 ? 1 : 0) + (sc_loc > 0 ? 1 : 0)
bool longGradeOK  = gradeAB ? lCats >= 3 : true
bool shortGradeOK = gradeAB ? sCats >= 3 : true

bool qualLong  = longScore  >= sniper_th and longScore  > shortScore and lCats >= minCats and longGradeOK and barstate.isconfirmed
bool qualShort = shortScore >= sniper_th and shortScore > longScore  and sCats >= minCats and shortGradeOK and barstate.isconfirmed

// debounce
var bool longActive  = false
var bool shortActive = false
bool sniperLong  = qualLong  and not longActive
bool sniperShort = qualShort and not shortActive
if barstate.isconfirmed
    if qualLong
        longActive := true
    if longScore < watch_th
        longActive := false
    if qualShort
        shortActive := true
    if shortScore < watch_th
        shortActive := false

// ===== RISK GUARDS =====
var float dayStartEq = na
if newDay
    dayStartEq := strategy.equity
float dayPnlPct = na(dayStartEq) or dayStartEq == 0 ? 0.0 : (strategy.equity - dayStartEq) / dayStartEq * 100.0
bool dayHalt = maxDayLossPct > 0 and dayPnlPct <= -maxDayLossPct

var int consecLoss = 0
if newDay
    consecLoss := 0
if ta.change(strategy.closedtrades) != 0 and strategy.closedtrades > 0
    if strategy.closedtrades.profit(strategy.closedtrades - 1) < 0
        consecLoss += 1
    else
        consecLoss := 0
bool lossHalt = maxConsecLoss > 0 and consecLoss >= maxConsecLoss
bool canTrade = inRange and not dayHalt and not lossHalt

// ===== TRADE LEVELS + SIZING =====
float stopDist = atrVal * atr_stop_m
f_qty() =>
    float riskCap = strategy.equity * riskPct / 100.0
    float q = (not na(stopDist) and stopDist > 0) ? riskCap / stopDist : na
    na(q) or q <= 0 ? na : q

var float eEntry = na
var float eStop  = na
var float eTp1   = na
var float eTp2   = na
var float eTp3   = na
var int   eBar   = na

// ===== ENTRIES =====
bool shortRegiOK = not useShortRegime or (not na(shortRegEma) and close < shortRegEma)
goLong  = sniperLong  and strategy.position_size == 0 and canTrade
goShort = sniperShort and strategy.position_size == 0 and canTrade and shortRegiOK
float qty = f_qty()

if goLong and not na(qty)
    eEntry := close
    eStop  := close - stopDist
    eTp1   := close + stopDist * rr_target
    eTp2   := close + stopDist * rr_target * 2
    eTp3   := close + stopDist * rr_target * 3
    eBar   := bar_index
    strategy.entry("L", strategy.long, qty = qty)
if goShort and not na(qty)
    eEntry := close
    eStop  := close + stopDist
    eTp1   := close - stopDist * rr_target
    eTp2   := close - stopDist * rr_target * 2
    eTp3   := close - stopDist * rr_target * 3
    eBar   := bar_index
    strategy.entry("S", strategy.short, qty = qty)

// ===== FEE-AWARE BREAKEVEN after TP1 fill =====
var bool beMoved = false
if strategy.position_size == 0
    beMoved := false
bool tp1Hit = strategy.position_size > 0 ? high >= eTp1 : strategy.position_size < 0 ? low <= eTp1 : false
if use_be and tp1Hit and not beMoved and strategy.position_size != 0
    float buf = eEntry * feeBufPct / 100.0
    eStop := strategy.position_size > 0 ? eEntry + buf : eEntry - buf
    beMoved := true

// ===== ATR TRAILING STOP (let winners run) =====
var float runHi = na
var float runLo = na
if strategy.position_size == 0
    runHi := na
    runLo := na
else
    runHi := na(runHi) ? high : math.max(runHi, high)
    runLo := na(runLo) ? low  : math.min(runLo, low)
float rNow = (strategy.position_size != 0 and not na(eEntry) and stopDist > 0) ? (strategy.position_size > 0 ? (close - eEntry) / stopDist : (eEntry - close) / stopDist) : 0.0
if useTrail and strategy.position_size != 0 and rNow >= trailStart
    float cand = strategy.position_size > 0 ? runHi - atrVal * trailAtrM : runLo + atrVal * trailAtrM
    eStop := strategy.position_size > 0 ? math.max(eStop, cand) : math.min(eStop, cand)

// ===== EXITS =====
// Scale-out OFF (default): single position, let the trailing stop / TP3 manage it.
// Scale-out ON: original tiered thirds. Stop is always the (trailing/BE) eStop.
if strategy.position_size > 0
    if useScaleOut
        strategy.exit("L-tp1", from_entry = "L", qty_percent = 33, limit = eTp1, stop = eStop)
        strategy.exit("L-tp2", from_entry = "L", qty_percent = 50, limit = eTp2, stop = eStop)
        strategy.exit("L-tp3", from_entry = "L", limit = eTp3, stop = eStop)
    else
        strategy.exit("L-x", from_entry = "L", stop = eStop, limit = useTrail ? na : eTp3)
if strategy.position_size < 0
    if useScaleOut
        strategy.exit("S-tp1", from_entry = "S", qty_percent = 33, limit = eTp1, stop = eStop)
        strategy.exit("S-tp2", from_entry = "S", qty_percent = 50, limit = eTp2, stop = eStop)
        strategy.exit("S-tp3", from_entry = "S", limit = eTp3, stop = eStop)
    else
        strategy.exit("S-x", from_entry = "S", stop = eStop, limit = useTrail ? na : eTp3)

// ===== TIME STOP =====
if maxBarsIn > 0 and strategy.position_size != 0 and not na(eBar) and (bar_index - eBar) >= maxBarsIn
    strategy.close_all(comment = "time stop")

// ===== VISUALS =====
bgcolor(showOOS and time >= oosDate ? color.new(color.orange, 92) : na, title = "OOS shade")
plotshape(goLong,  title = "Long",  style = shape.triangleup,   location = location.belowbar, color = color.new(#26a69a, 0), size = size.small)
plotshape(goShort, title = "Short", style = shape.triangledown, location = location.abovebar, color = color.new(#ef5350, 0), size = size.small)
plot(strategy.position_size != 0 ? eStop : na, "Stop", color = color.new(#ef5350, 0), style = plot.style_linebr)
plot(strategy.position_size != 0 ? eTp1 : na,  "TP1",  color = color.new(#26a69a, 30), style = plot.style_linebr)
plot(strategy.position_size != 0 ? eTp2 : na,  "TP2",  color = color.new(#26a69a, 55), style = plot.style_linebr)
plot(strategy.position_size != 0 ? eTp3 : na,  "TP3",  color = color.new(#26a69a, 70), style = plot.style_linebr)

// ===== INFO TABLE =====
var table info = table.new(position.top_right, 2, 7, border_width = 1)
if barstate.islast
    table.cell(info, 0, 0, "APEX v9", text_color = color.white, bgcolor = color.new(color.blue, 0))
    table.cell(info, 1, 0, str.tostring(regime), text_color = color.white, bgcolor = color.new(color.blue, 0))
    table.cell(info, 0, 1, "Long score",  text_color = color.gray)
    table.cell(info, 1, 1, str.tostring(longScore) + " (" + str.tostring(lCats) + " cat)", text_color = longScore >= sniper_th ? color.green : color.gray)
    table.cell(info, 0, 2, "Short score", text_color = color.gray)
    table.cell(info, 1, 2, str.tostring(shortScore) + " (" + str.tostring(sCats) + " cat)", text_color = shortScore >= sniper_th ? color.red : color.gray)
    table.cell(info, 0, 3, "Short regime", text_color = color.gray)
    table.cell(info, 1, 3, not useShortRegime ? "OFF" : shortRegiOK ? "BELOW EMA" : "BLOCKED", text_color = not useShortRegime ? color.gray : shortRegiOK ? color.red : color.new(color.gray, 50))
    table.cell(info, 0, 4, "Day PnL %",   text_color = color.gray)
    table.cell(info, 1, 4, str.tostring(dayPnlPct, "#.##"), text_color = dayPnlPct >= 0 ? color.green : color.red)
    table.cell(info, 0, 5, "Consec loss", text_color = color.gray)
    table.cell(info, 1, 5, str.tostring(consecLoss), text_color = lossHalt ? color.red : color.gray)
    table.cell(info, 0, 6, "Trading",     text_color = color.gray)
    table.cell(info, 1, 6, canTrade ? "ON" : "HALTED", text_color = canTrade ? color.green : color.red)
