//@version=6
indicator("APEX HUNTER PRO v3.0 ⚡ [Competition 2026]",
     overlay=true, max_labels_count=500, max_lines_count=500,
     max_boxes_count=500, max_bars_back=5000)

// ═══════════════════════════════════════════════════════════════════════
//  APEX HUNTER PRO v3.0 — Competition Edition
//  ✅ 4-Durum Volatilite Rejim Motoru
//  ✅ ICT Killzone Filtresi (London/NY/Asia)
//  ✅ Likidite Havuzu Haritalaması + Sweep Gate
//  ✅ OTE (Optimal Trade Entry) Fibonacci Bölgesi
//  ✅ Efficiency Ratio (Kaufman) Trend Filtresi
//  ✅ Power of 3 / AMD Modeli
//  ✅ CVD (Cumulative Volume Delta) Yaklaşımı
//  ✅ MSS vs BOS Ayrımı (Ağırlıklı)
//  ✅ Çoklu Ankrajlı VWAP
//  ✅ Adaptif ATR Stop/Hedef
//  ✅ Canlı Backtest İstatistikleri
//  ✅ Webhook JSON Alert
// ═══════════════════════════════════════════════════════════════════════

// ── INPUTS ──────────────────────────────────────────────────────────────
g0 = "🎯 İŞLEM AYARLARI"
i_mode     = input.string("HYBRID", "Mod", options=["SCALP","SWING","SNIPER","HYBRID"], group=g0)
i_lev      = input.float(10, "Kaldıraç x", 1, 125, 0.5, group=g0)
i_risk     = input.float(1.0, "Risk %", 0.1, 10, 0.1, group=g0)
i_minscore = input.int(68, "Min Sinyal Skoru", 0, 100, group=g0)

g1 = "📈 TREND"
i_hma    = input.int(55, "HMA", group=g1)
i_st_atr = input.int(10, "SuperTrend ATR", group=g1)
i_st_mul = input.float(2.5, "SuperTrend Çarpan", step=0.1, group=g1)
i_er_len = input.int(14, "Efficiency Ratio Uzunluk", group=g1)
i_mtf    = input.bool(true, "MTF Confluence", group=g1)

g2 = "🏦 ICT / SMC"
i_swing   = input.int(10, "Swing Uzunluk", group=g2)
i_show_ob = input.bool(true, "Order Block", group=g2)
i_show_fvg= input.bool(true, "Fair Value Gap", group=g2)
i_show_liq= input.bool(true, "Likidite Havuzları", group=g2)
i_show_kz = input.bool(true, "Killzone", group=g2)
i_ote     = input.bool(true, "OTE Bölgesi", group=g2)

g3 = "🛡 RİSK"
i_atr_len = input.int(14, "ATR Uzunluk", group=g3)
i_sl_base = input.float(1.5, "SL ATR Çarpan (baz)", step=0.1, group=g3)
i_tp1rr   = input.float(1.5, "TP1 RR", step=0.1, group=g3)
i_tp2rr   = input.float(2.5, "TP2 RR", step=0.1, group=g3)
i_tp3rr   = input.float(4.0, "TP3 RR", step=0.1, group=g3)

g4 = "🎨 GÖRSEL"
i_dash   = input.bool(true, "Dashboard", group=g4)
i_labels = input.bool(true, "AV/KAPAR Etiket", group=g4)
i_tpsl   = input.bool(true, "TP/SL Çizgi", group=g4)

// ═══════════════════════════════════════════════════════════════════════
//  BÖLÜM 1: TREND MATRİSİ
// ═══════════════════════════════════════════════════════════════════════
hma       = ta.hma(close, i_hma)
hma_up    = hma > hma[1]
hma_slope = (hma - hma[3]) / hma * 100

[st_line, st_dir] = ta.supertrend(i_st_mul, i_st_atr)
st_bull = st_dir < 0

ema8  = ta.ema(close, 8);  ema13 = ta.ema(close, 13)
ema21 = ta.ema(close, 21); ema34 = ta.ema(close, 34)
ema55 = ta.ema(close, 55); ema89 = ta.ema(close, 89)
ribbon_bull = ema8>ema13 and ema13>ema21 and ema21>ema34 and ema34>ema55
ribbon_bear = ema8<ema13 and ema13<ema21 and ema21<ema34 and ema34<ema55

// Kaufman Efficiency Ratio
er_net      = math.abs(close - close[i_er_len])
er_path     = math.sum(math.abs(ta.change(close)), i_er_len)
er          = er_path != 0 ? er_net / er_path : 0.0
er_trending = er > 0.45

// ═══════════════════════════════════════════════════════════════════════
//  BÖLÜM 2: 4-DURUM REJİM MOTORU
// ═══════════════════════════════════════════════════════════════════════
atr     = ta.atr(i_atr_len)
atr_pct = atr / close * 100

atr_hi   = ta.highest(atr, 252)
atr_lo   = ta.lowest(atr, 252)
atr_rank = (atr - atr_lo) / math.max(atr_hi - atr_lo, 0.00001) * 100

is_trending = er_trending and math.abs(hma_slope) > 0.05
is_volatile = atr_rank > 65

regime =
     not is_trending and not is_volatile ? 0 :
     not is_trending and is_volatile     ? 1 :
     is_trending     and not is_volatile ? 2 : 3

regime_mult =
     regime == 0 ? 1.10 :
     regime == 1 ? 0.80 :
     regime == 2 ? 1.00 : 0.95

regime_name =
     regime == 0 ? "🟡 RANGING (Sakin)"   :
     regime == 1 ? "🔥 RANGING (Volatil)" :
     regime == 2 ? "🟢 TREND (Sakin)"     : "⚡ TREND (Volatil)"

// ═══════════════════════════════════════════════════════════════════════
//  BÖLÜM 3: ICT KILLZONE
// ═══════════════════════════════════════════════════════════════════════
kz_london_open = i_show_kz and (hour(time,"UTC") >= 7  and hour(time,"UTC") < 10)
kz_ny_open     = i_show_kz and (hour(time,"UTC") >= 13 and hour(time,"UTC") < 16)
kz_london_cls  = i_show_kz and (hour(time,"UTC") >= 15 and hour(time,"UTC") < 17)
kz_asia        = i_show_kz and (hour(time,"UTC") >= 0  and hour(time,"UTC") < 4)
in_killzone    = kz_london_open or kz_ny_open or kz_london_cls or kz_asia

kz_color =
     kz_london_open ? color.new(#00aaff, 88) :
     kz_ny_open     ? color.new(#00ff88, 88) :
     kz_london_cls  ? color.new(#ff8800, 90) :
     kz_asia        ? color.new(#aa00ff, 92) : na

bgcolor(kz_color, title="Killzone Arka Plan")
kz_bonus = in_killzone ? 10 : 0

// ═══════════════════════════════════════════════════════════════════════
//  BÖLÜM 4: LİKİDİTE HAVUZU + SWEEP
// ═══════════════════════════════════════════════════════════════════════
liq_len1 = 20
liq_len2 = 50
prev_high20 = ta.highest(high[1], liq_len1)
prev_low20  = ta.lowest(low[1],  liq_len1)
prev_high50 = ta.highest(high[1], liq_len2)
prev_low50  = ta.lowest(low[1],  liq_len2)

sweep_bull     = low  < prev_low20  and close > prev_low20
sweep_bear     = high > prev_high20 and close < prev_high20
sweep_bull_big = low  < prev_low50  and close > prev_low50
sweep_bear_big = high > prev_high50 and close < prev_high50

var int sweep_signal = 0
if sweep_bull
    sweep_signal := 1
if sweep_bear
    sweep_signal := -1
if sweep_signal != 0 and bar_index - ta.barssince(sweep_bull or sweep_bear) > 5
    sweep_signal := 0

if i_show_liq and barstate.islast
    line.new(bar_index - liq_len1, prev_high20, bar_index + 3, prev_high20,
         color=color.new(color.orange, 40), style=line.style_dashed, width=1)
    line.new(bar_index - liq_len1, prev_low20,  bar_index + 3, prev_low20,
         color=color.new(color.orange, 40), style=line.style_dashed, width=1)
    line.new(bar_index - liq_len2, prev_high50, bar_index + 3, prev_high50,
         color=color.new(color.red, 20), style=line.style_dashed, width=2)
    line.new(bar_index - liq_len2, prev_low50,  bar_index + 3, prev_low50,
         color=color.new(color.red, 20), style=line.style_dashed, width=2)

// ═══════════════════════════════════════════════════════════════════════
//  BÖLÜM 5: SWING + MSS / BOS / CHOCH
// ═══════════════════════════════════════════════════════════════════════
swing_h = ta.pivothigh(high, i_swing, i_swing)
swing_l = ta.pivotlow(low,  i_swing, i_swing)

var float sh1 = na; var float sh2 = na
var float sl1 = na; var float sl2 = na

if not na(swing_h)
    sh2 := sh1
    sh1 := swing_h
if not na(swing_l)
    sl2 := sl1
    sl1 := swing_l

bos_bull   = not na(sh1) and not na(sh2) and ta.crossover(close, sh1)  and sh1 > sh2
bos_bear   = not na(sl1) and not na(sl2) and ta.crossunder(close, sl1) and sl1 < sl2
choch_bull = not na(sh1) and not na(sh2) and ta.crossover(close, sh1)  and sh1 < sh2
choch_bear = not na(sl1) and not na(sl2) and ta.crossunder(close, sl1) and sl1 > sl2
mss_bull   = choch_bull and sweep_bull
mss_bear   = choch_bear and sweep_bear

struct_bull_score = mss_bull ? 20 : choch_bull ? 12 : bos_bull ? 6 : 0
struct_bear_score = mss_bear ? 20 : choch_bear ? 12 : bos_bear ? 6 : 0

if i_show_fvg
    if bos_bull
        label.new(bar_index, low - atr*0.5, "BOS▲",
             color=color.new(#00ff88,20), textcolor=color.white,
             style=label.style_label_up, size=size.tiny)
    if bos_bear
        label.new(bar_index, high + atr*0.5, "BOS▼",
             color=color.new(#ff4444,20), textcolor=color.white,
             style=label.style_label_down, size=size.tiny)
    if choch_bull
        label.new(bar_index, low - atr*0.8, "CHoCH▲",
             color=color.aqua, textcolor=color.black,
             style=label.style_label_up, size=size.small)
    if choch_bear
        label.new(bar_index, high + atr*0.8, "CHoCH▼",
             color=color.orange, textcolor=color.black,
             style=label.style_label_down, size=size.small)
    if mss_bull
        label.new(bar_index, low - atr*1.2, "MSS ▲",
             color=color.new(#00ffff,0), textcolor=color.black,
             style=label.style_label_up, size=size.normal)
    if mss_bear
        label.new(bar_index, high + atr*1.2, "MSS ▼",
             color=color.new(#ff00ff,0), textcolor=color.black,
             style=label.style_label_down, size=size.normal)

// ═══════════════════════════════════════════════════════════════════════
//  BÖLÜM 6: FVG + ORDER BLOCK
// ═══════════════════════════════════════════════════════════════════════
fvg_bull = low > high[2] and close[1] > high[2]
fvg_bear = high < low[2] and close[1] < low[2]

if i_show_fvg
    if fvg_bull
        box.new(bar_index-2, high[2], bar_index+8, low,
             border_color=color.new(color.lime,50), bgcolor=color.new(color.lime,88))
    if fvg_bear
        box.new(bar_index-2, high, bar_index+8, low[2],
             border_color=color.new(color.red,50), bgcolor=color.new(color.red,88))

ob_bull = bos_bull and close[i_swing] < open[i_swing]
ob_bear = bos_bear and close[i_swing] > open[i_swing]

if i_show_ob
    if ob_bull
        box.new(bar_index-i_swing, low[i_swing], bar_index+12, high[i_swing],
             border_color=color.new(#00ff88,20), bgcolor=color.new(#00ff88,82))
    if ob_bear
        box.new(bar_index-i_swing, low[i_swing], bar_index+12, high[i_swing],
             border_color=color.new(#ff4444,20), bgcolor=color.new(#ff4444,82))

// ═══════════════════════════════════════════════════════════════════════
//  BÖLÜM 7: OTE — Optimal Trade Entry (Fibonacci 61.8–78.6%)
// ═══════════════════════════════════════════════════════════════════════
var float ote_high = na
var float ote_low  = na
var float ote_61   = na
var float ote_79   = na
var int   ote_dir  = 0
var int   ote_bar  = 0

if bos_bull or mss_bull
    ote_high := nz(sh1, high)
    ote_low  := nz(sl1, low)
    ote_61   := ote_high - (ote_high - ote_low) * 0.618
    ote_79   := ote_high - (ote_high - ote_low) * 0.786
    ote_dir  := 1
    ote_bar  := bar_index

if bos_bear or mss_bear
    ote_high := nz(sh1, high)
    ote_low  := nz(sl1, low)
    ote_61   := ote_low  + (ote_high - ote_low) * 0.618
    ote_79   := ote_low  + (ote_high - ote_low) * 0.786
    ote_dir  := -1
    ote_bar  := bar_index

in_ote_long  = i_ote and ote_dir ==  1 and close >= ote_79 and close <= ote_61
in_ote_short = i_ote and ote_dir == -1 and close >= ote_61 and close <= ote_79

if i_ote and barstate.islast and not na(ote_61) and not na(ote_79)
    line.new(ote_bar, ote_61, bar_index+3, ote_61,
         color=color.new(color.yellow,30), width=2, style=line.style_dotted)
    line.new(ote_bar, ote_79, bar_index+3, ote_79,
         color=color.new(color.yellow,30), width=2, style=line.style_dotted)
    box.new(ote_bar, ote_79, bar_index+3, ote_61,
         border_color=color.new(color.yellow,50), bgcolor=color.new(color.yellow,90))

// ═══════════════════════════════════════════════════════════════════════
//  BÖLÜM 8: CVD (Cumulative Volume Delta) Yaklaşımı
// ═══════════════════════════════════════════════════════════════════════
buy_vol = volume * ((close - low)  / math.max(high - low, 0.00001))
sell_vol= volume * ((high - close) / math.max(high - low, 0.00001))
delta   = buy_vol - sell_vol
cvd     = ta.cum(delta)
cvd_ema = ta.ema(cvd, 21)
cvd_bull = cvd > cvd_ema and delta > 0
cvd_bear = cvd < cvd_ema and delta < 0

cvd_bear_div = ta.highest(close,5) > ta.highest(close,5)[5] and ta.highest(cvd,5) < ta.highest(cvd,5)[5]
cvd_bull_div = ta.lowest(close,5)  < ta.lowest(close,5)[5]  and ta.lowest(cvd,5)  > ta.lowest(cvd,5)[5]

// ═══════════════════════════════════════════════════════════════════════
//  BÖLÜM 9: POWER OF 3 / AMD
// ═══════════════════════════════════════════════════════════════════════
var float session_open    = na
var float initial_range_h = na
var float initial_range_l = na

is_session_start = ta.change(dayofweek) != 0 or (hour(time,"UTC") == 0 and minute(time,"UTC") < 16)

if is_session_start
    session_open     := open
    initial_range_h  := high
    initial_range_l  := low

if not na(initial_range_h)
    initial_range_h := math.max(initial_range_h, high)
if not na(initial_range_l)
    initial_range_l := math.min(initial_range_l, low)

manipulation_up   = not na(initial_range_h) and high > initial_range_h + atr * 0.5 and close < initial_range_h
manipulation_down = not na(initial_range_l) and low  < initial_range_l - atr * 0.5 and close > initial_range_l

amd_short = manipulation_up
amd_long  = manipulation_down

// ═══════════════════════════════════════════════════════════════════════
//  BÖLÜM 10: ÇOKLU ANKRAJLI VWAP
// ═══════════════════════════════════════════════════════════════════════
vwap_daily = ta.vwap(hlc3)

var float vwap_anchor_sum = 0.0
var float vol_anchor_sum  = 0.0
var bool  anchor_active   = false

if not na(swing_h) and not na(sh2) and swing_h > sh2
    vwap_anchor_sum := 0.0
    vol_anchor_sum  := 0.0
    anchor_active   := true

if anchor_active
    vwap_anchor_sum := vwap_anchor_sum + hlc3 * volume
    vol_anchor_sum  := vol_anchor_sum + volume

vwap_anchored = anchor_active and vol_anchor_sum > 0 ? vwap_anchor_sum / vol_anchor_sum : vwap_daily
above_vwap    = close > vwap_daily
above_avwap   = close > vwap_anchored

plot(vwap_daily,    "VWAP (Günlük)", color.new(color.white, 20), 2)
plot(vwap_anchored, "AVWAP (Swing)", color.new(color.yellow, 30), 1, plot.style_linebr)

// ═══════════════════════════════════════════════════════════════════════
//  BÖLÜM 11: MOMENTUM + VOLUME
// ═══════════════════════════════════════════════════════════════════════
rsi = ta.rsi(close, 14)
rsi_bull_div = ta.lowest(low,5)  < ta.lowest(low,5)[5]  and ta.lowest(rsi,5)  > ta.lowest(rsi,5)[5]
rsi_bear_div = ta.highest(high,5)> ta.highest(high,5)[5] and ta.highest(rsi,5) < ta.highest(rsi,5)[5]

[macd, macd_sig, macd_hist] = ta.macd(close, 12, 26, 9)
macd_bull = macd > macd_sig and macd_hist > macd_hist[1]
macd_bear = macd < macd_sig and macd_hist < macd_hist[1]

stoch_k   = ta.sma(ta.stoch(rsi, rsi, rsi, 14), 3)
stoch_d   = ta.sma(stoch_k, 3)
stoch_xup = ta.crossover(stoch_k, stoch_d)  and stoch_k < 30
stoch_xdn = ta.crossunder(stoch_k, stoch_d) and stoch_k > 70

vol_sma  = ta.sma(volume, 20)
rvol     = volume / vol_sma
high_vol = rvol > 1.5

obv     = ta.cum(math.sign(ta.change(close)) * volume)
obv_ema = ta.ema(obv, 21)
cmf_val = ta.sma(((close-low)-(high-close)) / math.max(high-low, 0.00001) * volume, 20) /
          math.max(ta.sma(volume, 20), 0.00001)

bb_basis = ta.sma(close, 20)
bb_dev   = ta.stdev(close, 20)
kc_range = atr * 1.5
squeeze  = (bb_basis + 2*bb_dev) < (bb_basis + kc_range) and
           (bb_basis - 2*bb_dev) > (bb_basis - kc_range)
sq_release = not squeeze and squeeze[1] and high_vol

htf = timeframe.period == "1"  ? "15"  :
      timeframe.period == "5"  ? "60"  :
      timeframe.period == "15" ? "240" :
      timeframe.period == "60" ? "D"   : "W"

htf_bull = i_mtf ?
     request.security(syminfo.tickerid, htf, hma_up,     lookahead=barmerge.lookahead_off) : true
htf_bear = i_mtf ?
     request.security(syminfo.tickerid, htf, not hma_up, lookahead=barmerge.lookahead_off) : true

// ═══════════════════════════════════════════════════════════════════════
//  BÖLÜM 12: ADAPTİF SKORLAMA (Normalize)
// ═══════════════════════════════════════════════════════════════════════
f_norm(v, lo, hi) =>
    math.max(0.0, math.min(1.0, (v - lo) / math.max(hi - lo, 0.00001)))

// LONG bileşenler
s_trend_l = (hma_up  ? 1.0 : 0.0) * 0.7 + (st_bull  ? 1.0 : 0.0) * 0.3
s_ribbon_l = ribbon_bull ? 1.0 : ribbon_bear ? 0.0 : 0.5
s_er_l     = f_norm(er, 0.2, 0.8)
s_rsi_l    = f_norm(rsi, 40.0, 65.0)
s_macd_l   = macd_bull ? 1.0 : 0.3
s_cvd_l    = cvd_bull  ? 1.0 : 0.0
s_vol_l    = f_norm(rvol, 0.8, 2.5)
s_cmf_l    = f_norm(cmf_val, -0.2, 0.4)
s_vwap_l   = above_vwap and above_avwap ? 1.0 : above_vwap ? 0.6 : 0.0
s_mtf_l    = htf_bull ? 1.0 : 0.0
s_smc_l    = f_norm(float(struct_bull_score), 0.0, 20.0)
s_sweep_l  = sweep_bull or sweep_bull_big ? 1.0 : 0.0
s_ote_l    = in_ote_long  ? 1.0 : 0.5
s_amd_l    = amd_long  ? 1.0 : 0.5
s_sq_l     = sq_release and close > bb_basis ? 1.0 : 0.0

raw_long =
     s_trend_l  * 18 + s_ribbon_l * 8  + s_er_l    * 10 +
     s_rsi_l    * 8  + s_macd_l   * 8  + s_cvd_l   * 8  +
     s_vol_l    * 7  + s_cmf_l    * 5  + s_vwap_l  * 7  +
     s_mtf_l    * 8  + s_smc_l    * 7  + s_sweep_l * 5  +
     s_ote_l    * 4  + s_amd_l    * 3  + s_sq_l    * 4

long_score = int(math.min(100.0, raw_long * regime_mult)) + kz_bonus

// SHORT bileşenler
s_trend_s = (not hma_up  ? 1.0 : 0.0) * 0.7 + (not st_bull ? 1.0 : 0.0) * 0.3
s_ribbon_s = ribbon_bear ? 1.0 : ribbon_bull ? 0.0 : 0.5
s_rsi_s    = f_norm(100.0 - rsi, 40.0, 65.0)
s_macd_s   = macd_bear ? 1.0 : 0.3
s_cvd_s    = cvd_bear  ? 1.0 : 0.0
s_cmf_s    = f_norm(-cmf_val, -0.2, 0.4)
s_vwap_s   = not above_vwap and not above_avwap ? 1.0 : not above_vwap ? 0.6 : 0.0
s_mtf_s    = htf_bear ? 1.0 : 0.0
s_smc_s    = f_norm(float(struct_bear_score), 0.0, 20.0)
s_sweep_s  = sweep_bear or sweep_bear_big ? 1.0 : 0.0
s_ote_s    = in_ote_short ? 1.0 : 0.5
s_amd_s    = amd_short ? 1.0 : 0.5

raw_short =
     s_trend_s  * 18 + s_ribbon_s * 8  + s_er_l    * 10 +
     s_rsi_s    * 8  + s_macd_s   * 8  + s_cvd_s   * 8  +
     s_vol_l    * 7  + s_cmf_s    * 5  + s_vwap_s  * 7  +
     s_mtf_s    * 8  + s_smc_s    * 7  + s_sweep_s * 5  +
     s_ote_s    * 4  + s_amd_s    * 3  + s_sq_l    * 4

short_score = int(math.min(100.0, raw_short * regime_mult)) + kz_bonus

// ═══════════════════════════════════════════════════════════════════════
//  BÖLÜM 13: AV SİNYALLERİ
// ═══════════════════════════════════════════════════════════════════════
suppress = regime == 0 and not (mss_bull or mss_bear or amd_long or amd_short)

enough_l = long_score  >= i_minscore and not suppress
enough_s = short_score >= i_minscore and not suppress

scalp_mode = i_mode == "SCALP" or i_mode == "HYBRID"
swing_mode = i_mode == "SWING" or i_mode == "HYBRID"

trigger_long =
     (scalp_mode and (sweep_bull or amd_long or (sq_release and close > bb_basis))) or
     (swing_mode and (mss_bull or choch_bull or bos_bull)) or
     (i_mode == "SNIPER" and mss_bull and in_ote_long and in_killzone)

trigger_short =
     (scalp_mode and (sweep_bear or amd_short or (sq_release and close < bb_basis))) or
     (swing_mode and (mss_bear or choch_bear or bos_bear)) or
     (i_mode == "SNIPER" and mss_bear and in_ote_short and in_killzone)

av_long  = enough_l and trigger_long  and not (enough_l  and trigger_long)[1]
av_short = enough_s and trigger_short and not (enough_s and trigger_short)[1]

// ═══════════════════════════════════════════════════════════════════════
//  BÖLÜM 14: ADAPTİF RİSK YÖNETİMİ
// ═══════════════════════════════════════════════════════════════════════
sl_mult_adj = i_sl_base *
     (regime == 3 ? 1.4 : regime == 1 ? 1.6 : regime == 2 ? 1.0 : 1.2) *
     (long_score > 85 or short_score > 85 ? 0.9 : 1.0)

var float entry_p = na
var float sl_p    = na
var float tp1_p   = na
var float tp2_p   = na
var float tp3_p   = na
var int   trade_d = 0

if av_long
    entry_p := close
    sl_p    := math.min(nz(sl1, close - atr * sl_mult_adj) - atr * 0.3, close - atr * sl_mult_adj)
    risk_d   = entry_p - sl_p
    tp1_p   := entry_p + risk_d * i_tp1rr
    tp2_p   := entry_p + risk_d * i_tp2rr
    tp3_p   := entry_p + risk_d * i_tp3rr
    trade_d := 1

if av_short
    entry_p := close
    sl_p    := math.max(nz(sh1, close + atr * sl_mult_adj) + atr * 0.3, close + atr * sl_mult_adj)
    risk_d   = sl_p - entry_p
    tp1_p   := entry_p - risk_d * i_tp1rr
    tp2_p   := entry_p - risk_d * i_tp2rr
    tp3_p   := entry_p - risk_d * i_tp3rr
    trade_d := -1

kapar_long = trade_d == 1 and (
     ta.crossunder(close, sl_p) or
     (rsi > 78 and (rsi_bear_div or cvd_bear_div)) or
     mss_bear or
     ta.crossover(close, tp3_p))

kapar_short = trade_d == -1 and (
     ta.crossover(close, sl_p) or
     (rsi < 22 and (rsi_bull_div or cvd_bull_div)) or
     mss_bull or
     ta.crossunder(close, tp3_p))

if kapar_long or kapar_short
    trade_d := 0

// ═══════════════════════════════════════════════════════════════════════
//  BÖLÜM 15: CANLI BACKTEST İSTATİSTİKLERİ
// ═══════════════════════════════════════════════════════════════════════
var int   total_trades = 0
var int   wins         = 0
var float total_rr     = 0.0
var int   consec_loss  = 0
var int   max_cl       = 0

if av_long or av_short
    total_trades += 1

if kapar_long
    achieved_rr = (close - entry_p) / math.max(entry_p - sl_p, 0.00001)
    if achieved_rr > 0
        wins        += 1
        consec_loss := 0
        total_rr    += achieved_rr
    else
        consec_loss += 1
        max_cl      := math.max(max_cl, consec_loss)

if kapar_short
    achieved_rr = (entry_p - close) / math.max(sl_p - entry_p, 0.00001)
    if achieved_rr > 0
        wins        += 1
        consec_loss := 0
        total_rr    += achieved_rr
    else
        consec_loss += 1
        max_cl      := math.max(max_cl, consec_loss)

win_rate = total_trades > 0 ? float(wins) / float(total_trades) * 100.0 : 0.0
avg_rr   = wins > 0 ? total_rr / float(wins) : 0.0

// ═══════════════════════════════════════════════════════════════════════
//  BÖLÜM 16: GÖRSELLEŞTİRME
// ═══════════════════════════════════════════════════════════════════════
plot(hma,    "HMA",   hma_up  ? color.lime : color.red, 2)
plot(ema21,  "EMA21", color.new(#00aaff, 50), 1)
plot(ema55,  "EMA55", color.new(#ff00ff, 40), 1)
plot(st_line,"ST",    st_bull ? color.new(color.green,20) : color.new(color.red,20), 1, plot.style_linebr)

plot(i_tpsl and trade_d != 0 ? sl_p  : na, "SL",  color.red,                    2, plot.style_linebr)
plot(i_tpsl and trade_d != 0 ? tp1_p : na, "TP1", color.new(color.lime, 40),    1, plot.style_linebr)
plot(i_tpsl and trade_d != 0 ? tp2_p : na, "TP2", color.new(color.lime, 20),    1, plot.style_linebr)
plot(i_tpsl and trade_d != 0 ? tp3_p : na, "TP3", color.lime,                   2, plot.style_linebr)

if i_labels
    if av_long
        taktik  = mss_bull   ? "🎯 MSS"   : amd_long    ? "⚡ AMD"   : sweep_bull ? "🔍 SWEEP" : "📈 SWING"
        lbl_txt = "🟢 AV LONG\n" + taktik +
                  "\nSkor: " + str.tostring(long_score)  + "/100" +
                  "\nKZ: "   + (in_killzone  ? "✅" : "—") +
                  "\nOTE: "  + (in_ote_long  ? "✅" : "—") +
                  "\nER: "   + str.tostring(er, "#.##")   +
                  "\n"       + str.tostring(i_lev) + "x kaldıraç"
        label.new(bar_index, low - atr*2, lbl_txt,
             color=color.new(#00ff88,5), textcolor=color.white,
             style=label.style_label_up, size=size.normal)
    if av_short
        taktik  = mss_bear   ? "🎯 MSS"   : amd_short   ? "⚡ AMD"   : sweep_bear ? "🔍 SWEEP" : "📉 SWING"
        lbl_txt = "🔴 AV SHORT\n" + taktik +
                  "\nSkor: " + str.tostring(short_score) + "/100" +
                  "\nKZ: "   + (in_killzone  ? "✅" : "—") +
                  "\nOTE: "  + (in_ote_short ? "✅" : "—") +
                  "\nER: "   + str.tostring(er, "#.##")   +
                  "\n"       + str.tostring(i_lev) + "x kaldıraç"
        label.new(bar_index, high + atr*2, lbl_txt,
             color=color.new(#ff4444,5), textcolor=color.white,
             style=label.style_label_down, size=size.normal)
    if kapar_long
        label.new(bar_index, high + atr, "✖ KAPAR\nLONG çıkış",
             color=color.new(color.yellow,10), textcolor=color.black,
             style=label.style_label_down, size=size.small)
    if kapar_short
        label.new(bar_index, low - atr, "✖ KAPAR\nSHORT çıkış",
             color=color.new(color.yellow,10), textcolor=color.black,
             style=label.style_label_up, size=size.small)

plotshape(sweep_bull, "Sweep↑", shape.diamond, location.belowbar, color.new(color.lime,30), size=size.tiny)
plotshape(sweep_bear, "Sweep↓", shape.diamond, location.abovebar, color.new(color.red, 30), size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════
//  BÖLÜM 17: DASHBOARD
//  NOT: Pine Script'te fonksiyonlar global kapsamda tanımlanmalıdır.
//  Table referansı için var table global bildirim kullanıldı.
// ═══════════════════════════════════════════════════════════════════════
var table d = table.new(position.top_right, 2, 18,
     bgcolor=color.new(#0a0a1a, 10),
     border_color=color.new(color.gray, 50), border_width=1)

dash_cell(int r, int c, string t, color tc, color bc) =>
    table.cell(d, c, r, t, text_color=tc, bgcolor=bc, text_size=size.small)

if i_dash and barstate.islast
    r_c  = regime == 2 or regime == 3 ? color.lime : regime == 1 ? color.orange : color.gray
    er_c = er > 0.6 ? color.lime : er > 0.4 ? color.yellow : color.red
    l_c  = long_score  >= 80 ? color.lime   : long_score  >= 65 ? color.yellow : color.gray
    s_c  = short_score >= 80 ? color.red    : short_score >= 65 ? color.orange : color.gray
    wr_c = win_rate > 60 ? color.lime : win_rate > 45 ? color.yellow : color.red

    kz_nm = kz_london_open ? "🔵 London Açılış" :
            kz_ny_open     ? "🟢 NY Açılış"     :
            kz_london_cls  ? "🟠 London Kapanış" :
            kz_asia        ? "🟣 Asya"           : "⚪ Killzone Dışı"

    smc_st = mss_bull   ? "🔵 MSS LONG"  : mss_bear   ? "🔵 MSS SHORT" :
             choch_bull ? "🟢 CHoCH▲"   : choch_bear ? "🔴 CHoCH▼"   :
             bos_bull   ? "🟢 BOS▲"     : bos_bear   ? "🔴 BOS▼"     : "⚪ Yok"

    pos_st = trade_d == 1 ? "🟢 LONG AÇIK" : trade_d == -1 ? "🔴 SHORT AÇIK" : "⚪ Pozisyon Yok"
    pos_c  = trade_d == 1 ? color.lime      : trade_d == -1 ? color.red        : color.gray

    sweep_txt = sweep_bull     ? "🟢 BULL Sweep"  : sweep_bear     ? "🔴 BEAR Sweep"  :
                sweep_bull_big ? "🔥 BÜYÜK BULL"  : sweep_bear_big ? "🔥 BÜYÜK BEAR"  : "—"
    sweep_c   = sweep_bull or sweep_bull_big ? color.lime : sweep_bear or sweep_bear_big ? color.red : color.gray

    h1 = color.new(#0033aa, 30)
    h2 = color.new(#111122, 50)

    dash_cell(0,  0, "⚡ APEX HUNTER v3.0",                                                color.aqua,  h1)
    dash_cell(0,  1, i_mode + " | " + str.tostring(i_lev) + "x",                           color.white, h1)
    dash_cell(1,  0, "Rejim",                                                               color.gray,  h2)
    dash_cell(1,  1, regime_name,                                                           r_c,         h2)
    dash_cell(2,  0, "Efficiency Ratio",                                                    color.gray,  h2)
    dash_cell(2,  1, str.tostring(er,"#.##") + (er_trending ? " ✅" : " ❌"),               er_c,        h2)
    dash_cell(3,  0, "Killzone",                                                            color.gray,  h2)
    dash_cell(3,  1, kz_nm,                                                                 in_killzone ? color.lime : color.gray, h2)
    dash_cell(4,  0, "CVD Delta",                                                           color.gray,  h2)
    dash_cell(4,  1, cvd_bull ? "🟢 Alım Baskısı" : cvd_bear ? "🔴 Satış Baskısı" : "🟡 Nötr",
              cvd_bull ? color.lime : cvd_bear ? color.red : color.yellow, h2)
    dash_cell(5,  0, "SMC Yapı",                                                            color.gray,  h2)
    dash_cell(5,  1, smc_st,                                                                color.white, h2)
    dash_cell(6,  0, "Likidite Sweep",                                                      color.gray,  h2)
    dash_cell(6,  1, sweep_txt,                                                             sweep_c,     h2)
    dash_cell(7,  0, "OTE Bölgesi",                                                         color.gray,  h2)
    dash_cell(7,  1, in_ote_long ? "✅ LONG OTE" : in_ote_short ? "✅ SHORT OTE" : "—",
              in_ote_long or in_ote_short ? color.yellow : color.gray, h2)
    dash_cell(8,  0, "Power of 3",                                                          color.gray,  h2)
    dash_cell(8,  1, amd_long ? "🟢 BULL Manip." : amd_short ? "🔴 BEAR Manip." : "—",
              amd_long ? color.lime : amd_short ? color.red : color.gray, h2)
    dash_cell(9,  0, "LONG Skor",                                                           color.gray,  color.new(#001100,50))
    dash_cell(9,  1, str.tostring(long_score)  + "/100 " + (long_score  >= i_minscore ? "✅" : "❌"), l_c, color.new(#001100,50))
    dash_cell(10, 0, "SHORT Skor",                                                          color.gray,  color.new(#110000,50))
    dash_cell(10, 1, str.tostring(short_score) + "/100 " + (short_score >= i_minscore ? "✅" : "❌"), s_c, color.new(#110000,50))
    dash_cell(11, 0, "Pozisyon",                                                            color.gray,  color.new(#111133,50))
    dash_cell(11, 1, pos_st,                                                                pos_c,       color.new(#111133,50))
    dash_cell(12, 0, "Win Rate",                                                            color.gray,  h2)
    dash_cell(12, 1, str.tostring(win_rate,"#.#") + "% (" + str.tostring(wins) + "/" + str.tostring(total_trades) + ")", wr_c, h2)
    dash_cell(13, 0, "Ort. RR",                                                             color.gray,  h2)
    dash_cell(13, 1, "1:" + str.tostring(avg_rr,"#.##"),                                   avg_rr > 1.5 ? color.lime : color.yellow, h2)
    dash_cell(14, 0, "Max Ardışık Kayıp",                                                   color.gray,  h2)
    dash_cell(14, 1, str.tostring(max_cl),                                                  max_cl >= 3 ? color.red : color.white, h2)
    dash_cell(15, 0, "Risk/İşlem",                                                          color.gray,  h2)
    dash_cell(15, 1, str.tostring(i_risk,"#.#") + "% sermaye",                             color.white, h2)
    dash_cell(16, 0, "ATR %",                                                               color.gray,  h2)
    dash_cell(16, 1, str.tostring(atr_pct,"#.##") + "% | Rank:" + str.tostring(atr_rank,"#") + "%", color.white, h2)
    dash_cell(17, 0, "CVD Diverjans",                                                       color.gray,  h2)
    dash_cell(17, 1, cvd_bull_div ? "⚠️ BULL Div" : cvd_bear_div ? "⚠️ BEAR Div" : "Temiz",
              cvd_bull_div or cvd_bear_div ? color.orange : color.gray, h2)

// ═══════════════════════════════════════════════════════════════════════
//  BÖLÜM 18: ALERTLER (Webhook JSON)
// ═══════════════════════════════════════════════════════════════════════
alertcondition(av_long, "🟢 AV LONG",
     '{"signal":"LONG","symbol":"{{ticker}}","tf":"{{interval}}","price":"{{close}}",' +
     '"score":"' + str.tostring(long_score)  + '","regime":"' + regime_name +
     '","killzone":"' + (in_killzone ? "true" : "false") +
     '","ote":"'     + (in_ote_long ? "true" : "false") +
     '","sweep":"'   + (sweep_bull  ? "true" : "false") +
     '","mss":"'     + (mss_bull    ? "true" : "false") +
     '","er":"'      + str.tostring(er,"#.##") + '","action":"buy"}')

alertcondition(av_short, "🔴 AV SHORT",
     '{"signal":"SHORT","symbol":"{{ticker}}","tf":"{{interval}}","price":"{{close}}",' +
     '"score":"' + str.tostring(short_score) + '","regime":"' + regime_name +
     '","killzone":"' + (in_killzone  ? "true" : "false") +
     '","ote":"'      + (in_ote_short ? "true" : "false") +
     '","sweep":"'    + (sweep_bear   ? "true" : "false") +
     '","mss":"'      + (mss_bear     ? "true" : "false") +
     '","er":"'       + str.tostring(er,"#.##") + '","action":"sell"}')

alertcondition(kapar_long or kapar_short, "✖ KAPAR",
     '{"signal":"CLOSE","symbol":"{{ticker}}","tf":"{{interval}}","price":"{{close}}","action":"close"}')

alertcondition(mss_bull or mss_bear, "🎯 MSS SİNYALİ",
     '{"signal":"MSS","dir":"' + (mss_bull ? "LONG" : "SHORT") +
     '","symbol":"{{ticker}}","price":"{{close}}"}')
