# Bu dosyayı .env olarak kopyala ve doldur:  cp .env.example .env
# .env ASLA git'e gönderilmez (.gitignore'da).

# --- OKX API (dry-run için boş bırakılabilir) ---
# OKX > Profil > API: yetki SADECE "Trade" olsun. "Withdraw" (para çekme) KAPALI.
# IP kısıtlaması olarak VPS'in IP adresini gir.
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=
FREQTRADE__EXCHANGE__PASSWORD=

# --- Telegram (BotFather'dan token, @userinfobot'tan chat id) ---
FREQTRADE__TELEGRAM__ENABLED=false
FREQTRADE__TELEGRAM__TOKEN=
FREQTRADE__TELEGRAM__CHAT_ID=

# --- FreqUI / API güvenliği: rastgele uzun değerler gir ---
FREQTRADE__API_SERVER__PASSWORD=
FREQTRADE__API_SERVER__JWT_SECRET_KEY=
FREQTRADE__API_SERVER__WS_TOKEN=

# --- Canlıya geçiş: sadece en az 2 hafta dry-run'dan sonra ---
# FREQTRADE__DRY_RUN=false

# --- Sensör ayarları (opsiyonel) ---
# Tek işlemde kaç BTC "balina" sayılır
BOTNET_WHALE_BTC=10
# 15 dakikada kaç BTC likidasyon "dalga" sayılır
BOTNET_LIQ_WAVE_BTC=50
# Emir defterinde medyanın kaç katı "duvar" sayılır
BOTNET_WALL_MULT=8
# Learner: sinyalden kaç saniye sonraki fiyata bakılır (4 saat)
BOTNET_LEARN_HORIZON=14400
